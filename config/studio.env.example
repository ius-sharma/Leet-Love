# Copy to .env.local, which is gitignored. Never commit credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
E2B_API_KEY=
# A trusted sandbox template with Python 3 and Linux resource support.
E2B_TEMPLATE_ID=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Enable only after live tenancy, consent and sandbox acceptance checks pass.
LEETLOVE_PUBLISHING_ENABLED=false
# Enable after applying db/migrations/002_array_runs.sql and checking the sandbox.
LEETLOVE_ARRAY_RUNS_ENABLED=false

# Set only after migrations 003/004 and Google OAuth are configured.
LEETLOVE_AUTH_ENABLED=false
LEETLOVE_WAITLIST_ENABLED=false
# Exact local or deployed origin; add /auth/callback to Supabase redirect URLs.
AUTH_SITE_URL=http://127.0.0.1:3010
