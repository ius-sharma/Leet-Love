{
  "name": "leetlove",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:python": "tsx scripts/verify-python.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx workers/studio-worker.ts",
    "studio:examples": "tsx scripts/build-studio-examples.ts",
    "test:tracer": "python -E -S -m unittest discover -s tests/python -v"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "e2b": "^2.51.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
